<?xml version="1.0" encoding="UTF-8"?>
<!--DOCTYPE HDDS>

  Hall D Geometry Data Base: Kaon Flux Monitor Time of Flight Wall
  ********************************************

     version 1.0: Initial version (S. Fegan)
     version 2.0: M. Bashkanov's 2026-11 layout (kfm_straws.png): 22 columns of
                  12 cm; 14 x 260 cm bars (7 each side of a 24 cm centre slot),
                  6 x 190 cm bars (outer 3 columns each side, same centre - assumed,
                  cropped in the figure), the 116.5 and 114.5 cm bars side by side in
                  the slot above the beam (lower ends 12 cm above the beam axis),
                  nothing below the beam in the slot.  The bar centre is 46 cm above
                  the beam (read from the figure).  Origin = beam axis.
                  (claude/rtj 2026-11-21)
     version 2.1: bars kept clear of the lead donut (outer r 15) in the beam's-eye
                  view, as asked by M. Bashkanov: both side groups 3.5 cm further out
                  (inner edges at |x| = 15.5), the two centre bars 3.5 cm higher
                  (lower ends 15.5 above the beam); the wall can then sit beside the
                  donut, close to the Pb wall (placement in main_HDDS.xml)
                  (claude/rtj 2026-11-23)

<HDDS specification="v1.0" xmlns="http://www.gluex.org/hdds">
-->

<section name        = "KLFKFMTOF"
         version     = "2.1"
         date        = "2026-11-23"
         author      = "S.Fegan"
         top_volume  = "KFMN"
         specification = "v1.0">


<!-- Origin of the flux monitor TOF is the beam axis at the centre of the bar plane.
-->

  <composition name="KLFKFMTOF">
    <posXYZ volume="TOFBarsNorth" X_Y_Z="+75.5   46.0   0.0"/>
    <posXYZ volume="TOFBarsSouth" X_Y_Z="-75.5   46.0   0.0"/>
    <!-- two shortened bars in the centre slot, above the beam pipe only -->
    <posXYZ volume="TOFBarsCenter" X_Y_Z="0.0   73.75   0.0"/>
  </composition>
	

<!-- TOF Counters -->

<composition name="TOFBarsNorth" envelope="FMTN">
  <mposX volume="FMTF" ncopy="7" Y_Z="0.0 0.0" X0="-54" dX="12">  </mposX>
  <mposX volume="FMTH" ncopy="3" Y_Z="0.0 0.0" X0="30" dX="12">  </mposX>
</composition>

<composition name="TOFBarsSouth" envelope="FMTS">
  <mposX volume="FMTF" ncopy="7" Y_Z="0.0 0.0" X0="-18" dX="12">  </mposX>
  <mposX volume="FMTH" ncopy="3" Y_Z="0.0 0.0" X0="-54" dX="12">  </mposX>
</composition>

<composition name="TOFBarsCenter" envelope="FMTC">
  <posXYZ volume="FMTT" X_Y_Z="6.0 0.0 0.0">  </posXYZ>
  <posXYZ volume="FMTB" X_Y_Z="-6.0 -1.0 0.0">  </posXYZ>
  </composition>


  <box name="FMTF" X_Y_Z="11.99 260.0 2.0" material="Scintillator" sensitive="true"/>
  <box name="FMTH" X_Y_Z="11.99 190.0 2.0" material="Scintillator" sensitive="true"/>
  <box name="FMTT" X_Y_Z="11.99 116.5 2.0" material="Scintillator" sensitive="true" comment="y from 15.5 to 132.0 above the beam"/>
  <box name="FMTB" X_Y_Z="11.99 114.5 2.0" material="Scintillator" sensitive="true" comment="y from 15.5 to 130.0 above the beam"/>

  <box name="FMTN" X_Y_Z="120.0 262.0 3.0" material="Air" comment="Mother volume for flux monitor TOF bars" />
  <box name="FMTS" X_Y_Z="120.0 262.0 3.0" material="Air" comment="Mother volume for flux monitor TOF bars" />
  <box name="FMTC" X_Y_Z="24.0 116.6 3.0" material="Air" comment="Mother volume for flux monitor TOF bars" />



</section>

<!-- </HDDS> -->
